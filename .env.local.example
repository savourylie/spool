NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

THREADS_APP_ID=<your-threads-app-id>
THREADS_APP_SECRET=<your-threads-app-secret>
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/callback

TOKEN_ENCRYPTION_KEY=<run: openssl rand -hex 32>

CRON_SECRET=<random-secret-for-cron-auth>

ENABLE_INTERNAL_DEBUG_PAGES=false

# Server-default AI, used by everyone without their own key in Settings. Same
# meaning as a BYOK setting: LLM_PROVIDER is anthropic (default), openai, or xai.
# With openai, an LLM_BASE_URL makes it an OpenAI-compatible server (DashScope,
# OpenRouter, Ollama...), and LLM_MODEL is then required. LLM_API_KEY may be
# empty only for a keyless OpenAI-compatible server.
# Example (DashScope): LLM_PROVIDER=openai
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=deepseek-v4-pro
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=<your-provider-api-key>
# Optional: route the server default through Vercel AI Gateway instead (for
# example anthropic/claude-sonnet-4.6). Takes precedence over the LLM_* settings.
SPOOL_DEFAULT_MODEL=
# AI Gateway auth for local development and self-hosting. Deployments on Vercel
# use OIDC automatically once AI Gateway is enabled for the project.
AI_GATEWAY_API_KEY=

XAI_API_KEY=<your-xai-api-key>

YOUTUBE_API_KEY=<your-youtube-data-api-v3-key>
